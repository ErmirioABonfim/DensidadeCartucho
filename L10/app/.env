# ===============================================
# ARQUIVO DE CONFIGURAÇÃO PARA A LINHA 10 (L10)
# ===============================================

# 1. Caminho para o modelo (DENTRO do contêiner)
MODEL_PATH=/app/models_volume/L10_density_model.joblib

# 2. Tag de Status da L10 (usar valor 10 para predizer)
STATUS_TAG=ns=2;s=PackagingBox_L10_ACMA_VARPE.PLC L10 Acma.IIot_StatusUnifos

# 3. Tag de Escrita da L10 (Densidade Predita)
WRITE_TAG=ns=2;s=PackagingBox_L10_ACMA_VARPE.PLC L10 Acma.DensidadePreditaL10

# 4. URL do Servidor OPC UA
OPC_URL=opc.tcp://1.0.0.158:49320

# 5. Intervalo em segundos
INTERVAL_SECONDS=30
