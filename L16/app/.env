# ===============================================
# ARQUIVO DE CONFIGURAÇÃO PARA A LINHA 16 (L16)
# ===============================================

# 1. Caminho para o modelo (DENTRO do contêiner)
MODEL_PATH=/app/models_volume/L16_density_model.joblib

# 2. Tag de Status da L16 (usar valor 10 para predizer)
# TODO: Preencher com a tag correta da L16
STATUS_TAG=ns=2;s=<TAG_STATUS_L16>

# 3. Tag de Escrita da L16 (Densidade Predita)
# TODO: Preencher com a tag correta da L16
WRITE_TAG=ns=2;s=<TAG_ESCRITA_L16>

# 4. URL do Servidor OPC UA
OPC_URL=opc.tcp://1.0.0.158:49320

# 5. Intervalo em segundos
INTERVAL_SECONDS=30
