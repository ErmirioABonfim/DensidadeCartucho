# ===============================================
# ARQUIVO DE CONFIGURAÇÃO PARA A LINHA 02 (L02)
# ===============================================

# 1. Caminho para o modelo (DENTRO do contêiner)
# NOTA: Modelo L02 não existe ainda - container escreverá 0
MODEL_PATH=/app/models_volume/L02_density_model.joblib

# 2. Tag de Status da L02 (usar valor 10 para predizer)
# TODO: Preencher com a tag correta da L02
STATUS_TAG=ns=2;s=<TAG_STATUS_L02>

# 3. Tag de Escrita da L02 (Densidade Predita)
# TODO: Preencher com a tag correta da L02
WRITE_TAG=ns=2;s=<TAG_ESCRITA_L02>

# 4. URL do Servidor OPC UA
OPC_URL=opc.tcp://1.0.0.158:49320

# 5. Intervalo em segundos
INTERVAL_SECONDS=30
