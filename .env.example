# Copie para .env apenas fora do Git e substitua todos os placeholders.
# Nenhum valor operacional da VM71 foi copiado.
MODELS_DIR=./models

L02_OPC_URL=opc.tcp://<host>:<port>
L02_MODEL_PATH=/app/models_volume/<model-file>.joblib
L02_STATUS_TAG=<opc-status-node-id>
L02_WRITE_TAG=<opc-write-node-id>
L02_INTERVAL_SECONDS=<seconds>

L06_OPC_URL=opc.tcp://<host>:<port>
L06_MODEL_PATH=/app/models_volume/<model-file>.joblib
L06_STATUS_TAG=<opc-status-node-id>
L06_WRITE_TAG=<opc-write-node-id>
L06_INTERVAL_SECONDS=<seconds>

L16_OPC_URL=opc.tcp://<host>:<port>
L16_MODEL_PATH=/app/models_volume/<model-file>.joblib
L16_STATUS_TAG=<opc-status-node-id>
L16_WRITE_TAG=<opc-write-node-id>
L16_INTERVAL_SECONDS=<seconds>
