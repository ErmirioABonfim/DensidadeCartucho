# ===============================================
# ARQUIVO DE CONFIGURAÇÃO PARA A LINHA 01 (L01)
# ===============================================

# 1. Caminho para o modelo (DENTRO do contêiner)
MODEL_PATH=/app/models_volume/L01_density_model.joblib

# 2. Tag de Status da L01 (usar valor 10 para predizer)
# TODO: Preencher com a tag correta da L01
STATUS_TAG=ns=2;s=<TAG_STATUS_L01>

# 3. Tag de Escrita da L01 (Densidade Predita)
# TODO: Preencher com a tag correta da L01
WRITE_TAG=ns=2;s=<TAG_ESCRITA_L01>

# 4. URL do Servidor OPC UA
OPC_URL=opc.tcp://1.0.0.158:49320

# 5. Intervalo em segundos
INTERVAL_SECONDS=30
