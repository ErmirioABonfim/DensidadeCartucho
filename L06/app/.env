# ===============================================
# ARQUIVO DE CONFIGURAÇÃO PARA A LINHA 06 (L06)
# ===============================================

# 1. Caminho para o modelo (DENTRO do contêiner)
MODEL_PATH=/app/models_volume/L06_density_model.joblib

# 2. Tag de Status da L06 (usar valor 10 para predizer)
# TODO: Preencher com a tag correta da L06
STATUS_TAG=ns=2;s=<TAG_STATUS_L06>

# 3. Tag de Escrita da L06 (Densidade Predita)
# TODO: Preencher com a tag correta da L06
WRITE_TAG=ns=2;s=<TAG_ESCRITA_L06>

# 4. URL do Servidor OPC UA
OPC_URL=opc.tcp://1.0.0.158:49320

# 5. Intervalo em segundos
INTERVAL_SECONDS=30
